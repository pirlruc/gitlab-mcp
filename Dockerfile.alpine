# syntax=docker/dockerfile:1
# dhi.io/python:3.13-alpine3.24-dev — digest pinned (DOCKER-BUILD-003)
# Refresh digests: docker login dhi.io && bash scripts/pin-dhi-digests.sh
FROM dhi.io/python:3.13-alpine3.24-dev@sha256:5d6017e0892986aadd925910a4ccdb8c9a47d5b983decc2cb5ba50b63be3879e AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --no-editable

COPY src ./src
COPY README.md LICENSE ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

# dhi.io/python:3.13-alpine3.24 — digest pinned (DOCKER-BUILD-003)
FROM dhi.io/python:3.13-alpine3.24@sha256:23600b8ba837d09d2d403d8a0fcb2ca05464842670d3c5a0b3aa469baf5c0c48 AS runtime
ARG VERSION=0.0.0
ARG REVISION=unknown
ARG SOURCE=https://github.com/pirlruc/gitlab-mcp

LABEL org.opencontainers.image.title="gitlab-mcp" \
      org.opencontainers.image.description="MCP server for GitLab (stdio or streamable HTTP), Alpine" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="MIT"

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY --from=builder --chown=65532:65532 /app/.venv /app/.venv

USER 65532:65532
WORKDIR /app

EXPOSE 3333
ENTRYPOINT ["gitlab-mcp"]
